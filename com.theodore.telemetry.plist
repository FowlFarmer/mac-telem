<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.theodore.telemetry</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/theodore/mac-telem/report.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/theodore/mac-telem</string>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/theodore/Library/Logs/telemetry.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/theodore/Library/Logs/telemetry.stderr.log</string>

</dict>
</plist>
